<configuration>

	<configSections>
		<sectionGroup name="devExpress">
			<section name="themes" type="DevExpress.Web.ThemesConfigurationSection, DevExpress.Web.v25.1, Version=25.1.4.0, Culture=neutral, PublicKeyToken=b88d1754d700e49a" requirePermission="false" />
			<section name="compression" type="DevExpress.Web.CompressionConfigurationSection, DevExpress.Web.v25.1, Version=25.1.4.0, Culture=neutral, PublicKeyToken=b88d1754d700e49a" requirePermission="false" />
			<section name="settings" type="DevExpress.Web.SettingsConfigurationSection, DevExpress.Web.v25.1, Version=25.1.4.0, Culture=neutral, PublicKeyToken=b88d1754d700e49a" requirePermission="false" />
			<section name="errors" type="DevExpress.Web.ErrorsConfigurationSection, DevExpress.Web.v25.1, Version=25.1.4.0, Culture=neutral, PublicKeyToken=b88d1754d700e49a" requirePermission="false" />
			<section name="resources" type="DevExpress.Web.ResourcesConfigurationSection, DevExpress.Web.v25.1, Version=25.1.4.0, Culture=neutral, PublicKeyToken=b88d1754d700e49a" requirePermission="false" />
		</sectionGroup>
	</configSections>
	<connectionStrings>
  <add name="MyDbConnection" connectionString="Data Source=DESKTOP-8AE6JQR;Initial Catalog=Sri;Integrated Security=True;"
   providerName="System.Data.SqlClient" />
  <add name="ConnectionString" connectionString="XpoProvider=MSSqlServer;data source=;integrated security=SSPI;initial catalog=;Encrypt=False;TrustServerCertificate=False" />
 </connectionStrings>


	<devExpress>
		<themes enableThemesAssembly="true" styleSheetTheme="" theme="Office2003Blue" customThemeAssemblies="" baseColor="" font="" />
		<compression enableHtmlCompression="true" enableCallbackCompression="true" enableResourceCompression="true" enableResourceMerging="true" />
		<settings accessibilityCompliant="false" doctypeMode="Html5" rightToLeft="false" checkReferencesToExternalScripts="true" protectControlState="true" ieCompatibilityVersion="edge" />
		<errors callbackErrorRedirectUrl="" />
	</devExpress>
	
  <system.web>
		  <authentication mode="None" />
		  <authorization>
			  <allow users="*"/>
		  </authorization>

		  <webServices>
			  <protocols>
				  <add name="HttpGet"/>
				  <add name="HttpPost"/>
			  </protocols>
		  </webServices>

	  <compilation debug="true" strict="false" explicit="true" targetFramework="4.7.2">
		  <assemblies>
			  <add assembly="DevExpress.Web.v25.1, Version=25.1.4.0, Culture=neutral, PublicKeyToken=b88d1754d700e49a" />
			  <add assembly="DevExpress.Data.v25.1, Version=25.1.4.0, Culture=neutral, PublicKeyToken=b88d1754d700e49a" />
			  <!--<add assembly="DevExpress.Utils.v25.1, Version=25.1.4.0, Culture=neutral, PublicKeyToken=b88d1754d700e49a" />-->
			  <!--<add assembly="DevExpress.Web.ASPxThemes.v25.1, Version=25.1.4.0, Culture=neutral, PublicKeyToken=b88d1754d700e49a" />-->
		  </assemblies>
	  </compilation>
	  <httpRuntime targetFramework="4.7.2" />
	  <pages enableEventValidation="false">
		  <namespaces>
			  <add namespace="System.Web.Optimization" />
		  </namespaces>
		  <controls>
			  <add tagPrefix="uc" src="~/Controls/FilterBoxControl.ascx" tagName="FilterBox" />
			  <add tagPrefix="uc" src="~/Controls/MultiSelectFilter.ascx" tagName="MultiSelectFilter" />
			  <add assembly="Microsoft.AspNet.Web.Optimization.WebForms" namespace="Microsoft.AspNet.Web.Optimization.WebForms" tagPrefix="webopt" />
			  <add tagPrefix="dx" namespace="DevExpress.Data.Linq" assembly="DevExpress.Web.v25.1, Version=25.1.4.0, Culture=neutral, PublicKeyToken=b88d1754d700e49a" />
			  <add tagPrefix="dx" namespace="DevExpress.Web" assembly="DevExpress.Web.v25.1, Version=25.1.4.0, Culture=neutral, PublicKeyToken=b88d1754d700e49a" />
			  <add tagPrefix="dx" namespace="DevExpress.Web.ASPxTreeList" assembly="DevExpress.Web.ASPxTreeList.v25.1, Version=25.1.4.0, Culture=neutral, PublicKeyToken=b88d1754d700e49a" />
			  <add tagPrefix="dx" namespace="DevExpress.Web.ASPxPivotGrid" assembly="DevExpress.Web.ASPxPivotGrid.v25.1, Version=25.1.4.0, Culture=neutral, PublicKeyToken=b88d1754d700e49a" />
			  <add tagPrefix="dx" namespace="DevExpress.Web.ASPxSpellChecker" assembly="DevExpress.Web.ASPxSpellChecker.v25.1, Version=25.1.4.0, Culture=neutral, PublicKeyToken=b88d1754d700e49a" />
			  <add tagPrefix="dx" namespace="DevExpress.Web.ASPxHtmlEditor" assembly="DevExpress.Web.ASPxHtmlEditor.v25.1, Version=25.1.4.0, Culture=neutral, PublicKeyToken=b88d1754d700e49a" />
		  </controls>
	  </pages>
	  <httpModules>
		  <add type="DevExpress.Web.ASPxHttpHandlerModule, DevExpress.Web.v25.1, Version=25.1.4.0, Culture=neutral, PublicKeyToken=b88d1754d700e49a" name="ASPxHttpHandlerModule" />
	  </httpModules>
	  <httpHandlers>
		  <add type="DevExpress.Web.ASPxHttpHandlerModule, DevExpress.Web.v25.1, Version=25.1.4.0, Culture=neutral, PublicKeyToken=b88d1754d700e49a" verb="GET,POST" path="DX.ashx" validate="false" />
		  <add type="DevExpress.Web.ASPxUploadProgressHttpHandler, DevExpress.Web.v25.1, Version=25.1.4.0, Culture=neutral, PublicKeyToken=b88d1754d700e49a" verb="GET,POST" path="ASPxUploadProgressHandlerPage.ashx" validate="false" />
	  </httpHandlers>
  </system.web>
  <system.webServer>
	  <modules runAllManagedModulesForAllRequests="true">
		  <add type="DevExpress.Web.ASPxHttpHandlerModule, DevExpress.Web.v25.1, Version=25.1.4.0, Culture=neutral, PublicKeyToken=b88d1754d700e49a" name="ASPxHttpHandlerModule" />
	  </modules>
	  <handlers>
		  <remove name="PageHandlerFactory-Integrated-4.0" />
		  <add name="PageHandlerFactory-Integrated-4.0" path="*.aspx" verb="*" type="System.Web.UI.PageHandlerFactory" preCondition="integratedMode" />
		  <add type="DevExpress.Web.ASPxHttpHandlerModule, DevExpress.Web.v25.1, Version=25.1.4.0, Culture=neutral, PublicKeyToken=b88d1754d700e49a" verb="GET,POST" path="DX.ashx" name="ASPxHttpHandlerModule" preCondition="integratedMode" />
		  <add type="DevExpress.Web.ASPxUploadProgressHttpHandler, DevExpress.Web.v25.1, Version=25.1.4.0, Culture=neutral, PublicKeyToken=b88d1754d700e49a" verb="GET,POST" path="ASPxUploadProgressHandlerPage.ashx" name="ASPxUploadProgressHandler" preCondition="integratedMode" />
	  </handlers>
	  <validation validateIntegratedModeConfiguration="false" />
  </system.webServer>
  <!-- Allow anonymous access to Default.aspx and its WebMethods -->
  <location path="Default.aspx">
	  <system.web>
		  <authorization>
			  <allow users="*" />
		  </authorization>
	  </system.web>
  </location>
  <!-- Explicitly allow anonymous access to CheckKPIExists WebMethod -->
  <location path="Default.aspx/CheckKPIExists">
	  <system.web>
		  <authorization>
			  <allow users="*" />
		  </authorization>
	  </system.web>
  </location>
